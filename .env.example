# .env に複製して、実際の値を書く(.env はGit管理外)。
# 変数の名前は、config/factory.config.yml の token_env と合わせる。
# トークンは対象リポジトリだけに限定し、権限はイシューとコンテンツに絞る。
GITHUB_TOKEN_EXAMPLE=replace-with-your-own-token

# ホストの docker グループの番号。起動係がDockerソケットを使うために要る。
# 値は `getent group docker | cut -d: -f3` で調べる。
DOCKER_GID=999

# ワーカーの基本イメージに、ビルドで付ける名前。既定(factory-worker)のままなら書かない。
# 変えるときは、config/factory.config.yml の worker_image と同じ値にする。
# WORKER_IMAGE=factory-worker
